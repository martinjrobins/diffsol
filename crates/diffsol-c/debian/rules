#!/usr/bin/make -f
# Build the Debian packages libdiffsol<soversion> and libdiffsol-dev from the crate diffsol-c.
# Run `debian/prepare.sh` first: it writes the files that depend on the crate version (control,
# changelog, soversion and the .install file of the runtime package).
#
# Cargo writes the library as libdiffsol_c.so. The packages install it as
# libdiffsol.so.<version>, with the SONAME libdiffsol.so.<soversion>, so that the names of the
# library and of the packages agree.

include /usr/share/dpkg/pkg-info.mk
include /usr/share/dpkg/architecture.mk

VERSION := $(DEB_VERSION_UPSTREAM)
SOVERSION := $(shell cat debian/soversion)
LIBDIR := usr/lib/$(DEB_HOST_MULTIARCH)
FEATURES := diffsl-cranelift,diffsl-llvm17,diffsl-external-dynamic

# the crate is part of the workspace two directories up
export CARGO_TARGET_DIR ?= $(abspath $(CURDIR)/../../target)
export LLVM_SYS_170_PREFIX ?= /usr/lib/llvm-17
# build.rs gives the library this SONAME
export DIFFSOL_SONAME := libdiffsol.so.$(SOVERSION)

%:
	dh $@

override_dh_auto_build:
	cargo build -p diffsol-c --release --features $(FEATURES)

override_dh_auto_install:
	install -D -m 0644 $(CARGO_TARGET_DIR)/release/libdiffsol_c.so \
		debian/tmp/$(LIBDIR)/libdiffsol.so.$(VERSION)
	ln -s libdiffsol.so.$(VERSION) debian/tmp/$(LIBDIR)/$(DIFFSOL_SONAME)
	ln -s $(DIFFSOL_SONAME) debian/tmp/$(LIBDIR)/libdiffsol.so
	install -D -m 0644 $(CARGO_TARGET_DIR)/release/include/diffsol.h \
		debian/tmp/usr/include/diffsol.h
	mkdir -p debian/tmp/$(LIBDIR)/pkgconfig
	sed -e 's|@VERSION@|$(VERSION)|' -e 's|@LIBDIR@|/$(LIBDIR)|' debian/diffsol.pc.in \
		> debian/tmp/$(LIBDIR)/pkgconfig/diffsol.pc

# the workflow tests the installed packages; the build keeps the Cargo target directory
override_dh_auto_test:
override_dh_auto_clean:

# a release build of the library has no debug information
override_dh_strip:
	dh_strip --no-automatic-dbgsym
override_dh_dwz:
